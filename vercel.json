{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pianobackingsbydaniele.vercel.app" }],
      "destination": "https://pianobackings.danielebuatti.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/shop/:id", "destination": "/api/shop-product?id=:id" },
    { "source": "/", "destination": "/seo/home.html" },
    { "source": "/shop", "destination": "/seo/shop.html" },
    { "source": "/form-page", "destination": "/seo/form-page.html" },
    { "source": "/pricing", "destination": "/seo/pricing.html" },
    { "source": "/about", "destination": "/seo/about.html" },
    { "source": "/terms", "destination": "/seo/terms.html" },
    { "source": "/privacy", "destination": "/seo/privacy.html" },
    { "source": "/(login|user-dashboard|gmail-oauth-callback|purchase-confirmation|admin|ig|email-generator)", "destination": "/index.html" },
    { "source": "/(test-email|test-email-notification|test-backings|test-dropbox|test-dropbox-credentials)", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/email-generator/:id", "destination": "/index.html" },
    { "source": "/track/:id", "destination": "/index.html" }
  ]
}
