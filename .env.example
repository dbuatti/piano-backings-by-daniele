# Copy to `.env.local` for local development (it is git-ignored via `*.local`).
#
# Two different homes, do not mix them up:
#   • VITE_*  — read by the BROWSER. They are baked in at build time, so on
#               production they live in Vercel → Settings → Environment
#               Variables, and change only after a redeploy.
#   • the rest — Edge Function secrets. They live in Supabase → Project
#               Settings → Edge Functions → Secrets and are read at call time.
#
# Settings → Integrations in the admin app renders these same steps, with the
# live value of each redirect URI.

# ── Frontend (Vercel) ────────────────────────────────────────────────────────
VITE_SITE_URL=https://pianobackings.danielebuatti.com
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>            # public by design; protects nothing on its own
VITE_GMAIL_CLIENT_ID=<google-oauth-client-id>
VITE_GEMINI_API_KEY=<gemini-api-key>
VITE_TIKTOK_CLIENT_KEY=<tiktok-client-key>    # same value as TIKTOK_CLIENT_KEY below
VITE_INSTAGRAM_CLIENT_ID=<instagram-app-id>   # same value as INSTAGRAM_CLIENT_ID below

# ── Edge Function secrets (Supabase) ─────────────────────────────────────────
# Supabase platform
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>  # server-only, never expose

# Site / admin
SITE_URL=https://pianobackings.danielebuatti.com
ADMIN_EMAIL=<admin@example.com>
BCC_EMAIL=<bcc@example.com>
YT_ACCOUNT_EMAIL=<youtube-channel-owner@example.com>

# Google (Gmail send + YouTube upload)
GMAIL_CLIENT_ID=<google-oauth-client-id>
GMAIL_CLIENT_SECRET=<google-oauth-client-secret>
GMAIL_USER=<gmail-sender@example.com>

# Gemini (copy generation)
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# TikTok (Content Posting + Login Kit)
TIKTOK_CLIENT_KEY=<tiktok-client-key>
TIKTOK_CLIENT_SECRET=<tiktok-client-secret>

# Instagram (Instagram Business Login)
INSTAGRAM_CLIENT_ID=<instagram-app-id>
INSTAGRAM_CLIENT_SECRET=<instagram-app-secret>

# Stripe
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>

# Notion
NOTION_TOKEN=<notion-token>
NOTION_PRODUCTS_DATABASE_ID=<id>
NOTION_REQUESTS_DATABASE_ID=<id>

# Dropbox (delivery archives)
DROPBOX_APP_KEY=<dropbox-app-key>
DROPBOX_APP_SECRET=<dropbox-app-secret>
DROPBOX_REFRESH_TOKEN=<dropbox-refresh-token>
DROPBOX_PARENT_FOLDER=<dropbox-folder-path>

# Publishing workers (tunable, optional — sane defaults in code)
CONTENT_RETENTION_DAYS=30
PUBLISH_CONFIRM_GRACE_MINUTES=15
LOGIC_TEMPLATE_PATH=<path-inside-function>
