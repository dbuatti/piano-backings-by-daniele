# Stripe
export STRIPE_SECRET_KEY="${STRIPE_SECRET_KEY:?missing STRIPE_SECRET_KEY in .env}"
export STRIPE_WEBHOOK_SECRET="${STRIPE_WEBHOOK_SECRET:?missing STRIPE_WEBHOOK_SECRET in .env}"

# Notion
export NOTION_TOKEN="${NOTION_TOKEN:?missing NOTION_TOKEN in .env}"
