export NOTION_REQUESTS_DATABASE_ID="${NOTION_REQUESTS_DATABASE_ID:?missing NOTION_REQUESTS_DATABASE_ID in .env}"

# Dropbox
export DROPBOX_APP_KEY="${DROPBOX_APP_KEY:?missing DROPBOX_APP_KEY in .env}"
export DROPBOX_APP_SECRET="${DROPBOX_APP_SECRET:?missing DROPBOX_APP_SECRET in .env}"
