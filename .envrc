# piano-backings-by-daniele — per-project env (auto-loaded by direnv on cd)
dotenv

# Supabase — shared project kyfofikkswxtwgtqutdu (with scales.os)
export VITE_SUPABASE_URL="${VITE_SUPABASE_URL:?missing VITE_SUPABASE_URL in .env}"
