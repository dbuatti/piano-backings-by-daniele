# Supabase (service role — the same project the shop uses)
SUPABASE_URL=https://kyfofikkswxtwgtqutdu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser
HEADLESS=1                 # 1 = headless (server). 0 = visible window (needed for login on a desktop).
USER_DATA_DIR=./.auth/profile   # persistent Chrome profile (holds the logged-in session)
TZ=Europe/Rome
# Optional: pin a proxy so the login IP and the posting IP match (see README)
# HTTPS_PROXY=http://user:pass@host:port

# Behaviour
POLL_SECONDS=300           # how often to look for due teasers
MAX_PER_RUN=2              # safety cap per pass
DRY_RUN=0                  # 1 = stop right before clicking Post, screenshot instead
